{
  "manifest_version": 3,

  "name": "ClickDetect AI",

  "description": "AI-powered clickbait detection for article headlines and YouTube videos.",

  "version": "1.0.0",

  "background": {
    "service_worker": "background/background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ClickDetect AI"
},
  

  "permissions": [

    "storage",

    "activeTab"

  ],



  "host_permissions": [

    "http://127.0.0.1:8000/*"

  ],

  "content_scripts": [

    {

      "matches": [

        "<all_urls>"

      ],

      "js": [

        "content.bundle.js"

      ],

      "css": [

        "styles/popup.css"

      ],

      "run_at": "document_idle"

    }

  ],

  "web_accessible_resources": [

    {

      "resources": [

        "icons/*"

      ],

      "matches": [

        "<all_urls>"

      ]

    }

  ]

}